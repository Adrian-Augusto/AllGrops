NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/your_database
JWT_SECRET=replace-with-a-secure-secret

# Mercado Pago Configuration
MERCADO_PAGO_ACCESS_TOKEN=YOUR_MERCADO_PAGO_ACCESS_TOKEN
MERCADO_PAGO_WEBHOOK_URL=https://your-domain.com/api/v1/payments/webhook
# Optional: Add webhook signing secret for production
# MERCADO_PAGO_WEBHOOK_SECRET=your-webhook-signing-secret

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Frontend Configuration
FRONTEND_URL=http://localhost:3001

# Email Configuration
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-app-gmail

