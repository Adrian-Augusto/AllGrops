generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String?
  googleId      String?        @unique
  profileImage  String?
  role          UserRole       @default(COMMON)
  createdAt     DateTime       @default(now())
  groups        Group[]        @relation("GroupOwner")
  memberships   Membership[]
  subscriptions Subscription[]
}

model Group {
  id          String            @id @default(uuid())
  name        String
  description String
  categoryId  String
  ownerId     String
  isFeatured  Boolean           @default(false)
  status      GroupStatus       @default(PENDING)
  createdAt   DateTime          @default(now())
  owner       User              @relation("GroupOwner", fields: [ownerId], references: [id])
  category    Category          @relation(fields: [categoryId], references: [id])
  memberships Membership[]
  subscriptions Subscription[]
  posts       Post[]
}

model Category {
  id     String  @id @default(uuid())
  name   String  @unique
  groups Group[]
}

model Membership {
  id      String         @id @default(uuid())
  userId  String
  groupId String
  role    MembershipRole @default(MEMBER)
  user    User           @relation(fields: [userId], references: [id])
  group   Group          @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  price         Float
  duration      Int
  subscriptions Subscription[]
}

model Subscription {
  id      String             @id @default(uuid())
  userId  String
  groupId String
  planId  String
  status  SubscriptionStatus @default(PENDING)
  isActive Boolean            @default(false)
  paymentId String?
  createdAt DateTime          @default(now())
  user    User               @relation(fields: [userId], references: [id])
  group   Group              @relation(fields: [groupId], references: [id])
  plan    Plan               @relation(fields: [planId], references: [id])
}

model Post {
  id          String   @id @default(uuid())
  title       String
  description String
  link        String?
  platform    String?
  photo       String?
  groupId     String
  createdAt   DateTime @default(now())
  group       Group    @relation(fields: [groupId], references: [id])
}

enum UserRole {
  ADMIN
  COMMON
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum GroupStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  PENDING
  APPROVED
  REJECTED
}
