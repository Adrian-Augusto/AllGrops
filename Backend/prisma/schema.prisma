generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(uuid())
  name             String
  email            String         @unique
  password         String?
  googleId         String?        @unique
  profileImage     String?
  role             UserRole       @default(COMMON)
  // Terms acceptance
  termsAccepted    Boolean        @default(false)
  termsVersion     Int            @default(0)
  termsAcceptedAt  DateTime?
  // Online tracking
  lastActivityAt   DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdGroups    Group[]        @relation("GroupCreator")
  reviewedGroups   Group[]        @relation("GroupReviewer")
  memberships      Membership[]
  subscriptions    Subscription[]
  posts            Post[]
  comments         Comment[]

  @@index([email])
  @@index([googleId])
  @@index([role])
  @@index([lastActivityAt])
}

model Group {
  id              String       @id @default(uuid())
  name            String
  description     String?
  link            String
  platform        String
  photoUrl        String

  status          GroupStatus  @default(PENDING)

  createdById     String
  createdBy       User         @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)

  reviewedById    String?
  reviewedBy      User?        @relation("GroupReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?

  rejectionReason String?

  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id])

  isFeatured      Boolean      @default(false)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships     Membership[]
  subscriptions   Subscription[]
  posts           Post[]

  @@index([status])
  @@index([categoryId])
  @@index([createdById])
  @@index([isFeatured])
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  groups    Group[]

  @@unique([name(mode: "insensitive")])
  @@index([slug])
}

model Membership {
  id        String         @id @default(uuid())
  userId    String
  groupId   String
  role      MembershipRole @default(MEMBER)
  joinedAt  DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

model Plan {
  id                    String         @id @default(uuid())
  name                  String         @unique
  price                 Float
  type                  PlanType
  description           String?
  durationDays          Int            @default(30)
  maxSponsoredGroups    Int            @default(0)
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  subscriptions         Subscription[]

  @@index([type])
  @@index([isActive])
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  groupId   String?            // Opcional: null para planos premium de conta
  planId    String
  status    SubscriptionStatus @default(PENDING)
  isActive  Boolean            @default(false)
  expiresAt DateTime?          // Quando o patrocínio expira
  paymentId String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group?             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id])
  payment   Payment?

  @@index([userId])
  @@index([groupId])
  @@index([planId])
  @@index([status])
  @@index([expiresAt])
}

model Payment {
  id                String        @id @default(uuid())
  stripePaymentId   String?       @unique
  stripeCustomerId  String?
  subscriptionId    String        @unique
  status            PaymentStatus @default(PENDING)
  idempotencyKey    String        @unique
  webhookProcessed  Boolean       @default(false)
  lastWebhookId     String?
  externalReference String?
  customerEmail     String?
  amount            Float?
  currency          String?       @default("BRL")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([subscriptionId])
  @@index([stripePaymentId])
}

model Post {
  id          String      @id @default(uuid())
  title       String
  description String
  link        String?
  platform    String?
  photo       String?
  groupId     String
  userId      String
  status      PostStatus  @default(PUBLISHED)
  likes       Int         @default(0)
  views       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    Comment[]

  @@index([groupId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model RequestLog {
  id          String   @id @default(uuid())
  method      String
  path        String
  statusCode  Int
  userId      String?
  userAgent   String?
  ip          String?
  duration    Int      // em ms
  success     Boolean
  errorMessage String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([path])
  @@index([createdAt])
  @@index([success])
}

enum UserRole {
  ADMIN
  COMMON
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum GroupStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum SubscriptionStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum PlanType {
  SPONSORED_3_DAYS
  SPONSORED_7_DAYS
  PREMIUM_15_DAYS
  PREMIUM_30_DAYS
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  postId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}
