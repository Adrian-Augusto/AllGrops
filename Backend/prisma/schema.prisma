generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(uuid())
  name             String
  email            String         @unique
  password         String?
  googleId         String?        @unique
  profileImage     String?
  role             UserRole       @default(COMMON)
  // Terms acceptance
  termsAccepted    Boolean        @default(false)
  termsVersion     Int            @default(0)
  termsAcceptedAt  DateTime?
  // Online tracking
  lastActivityAt   DateTime?
  // Credit system
  credit           Float          @default(0)
  createdAt        DateTime       @default(now())
  createdGroups    Group[]        @relation("GroupCreator")
  reviewedGroups   Group[]        @relation("GroupReviewer")
  memberships      Membership[]
  subscriptions    Subscription[]
  posts            Post[]
}

model Group {
  id              String       @id @default(uuid())
  name            String
  description     String?
  link            String
  platform        String
  photoUrl        String

  status          GroupStatus  @default(PENDING)

  createdById     String
  createdBy       User         @relation("GroupCreator", fields: [createdById], references: [id])

  reviewedById    String?
  reviewedBy      User?        @relation("GroupReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?

  rejectionReason String?

  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id])

  isFeatured      Boolean      @default(false)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships     Membership[]
  subscriptions   Subscription[]
  posts           Post[]

  @@index([status])
  @@index([categoryId])
}

model Category {
  id     String  @id @default(uuid())
  name   String
  slug   String  @unique
  groups Group[]

  @@unique([name(mode: "insensitive")])
  @@index([slug])
}

model Membership {
  id      String         @id @default(uuid())
  userId  String
  groupId String
  role    MembershipRole @default(MEMBER)
  user    User           @relation(fields: [userId], references: [id])
  group   Group          @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

model Plan {
  id                    String         @id @default(uuid())
  name                  String         @unique
  price                 Float
  type                  PlanType
  description           String?
  durationDays          Int            @default(30)
  maxSponsoredGroups    Int            @default(0)
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  subscriptions         Subscription[]
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  groupId   String?            // Opcional: null para planos premium de conta
  planId    String
  status    SubscriptionStatus @default(PENDING)
  isActive  Boolean            @default(false)
  expiresAt DateTime?          // Quando o patrocínio expira
  paymentId String?
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id])
  group     Group?             @relation(fields: [groupId], references: [id])
  plan      Plan               @relation(fields: [planId], references: [id])
  payment   Payment?
}

model Payment {
  id                String   @id @default(uuid())
  mercadoPagoId     String?  @unique
  subscriptionId    String   @unique
  status            String   @default("PENDING")
  idempotencyKey    String   @unique
  webhookProcessed  Boolean  @default(false)
  lastWebhookId     String?
  externalReference String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model Post {
  id          String   @id @default(uuid())
  title       String
  description String
  link        String?
  platform    String?
  photo       String?
  groupId     String
  userId      String
  createdAt   DateTime @default(now())
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RequestLog {
  id          String   @id @default(uuid())
  method      String
  path        String
  statusCode  Int
  userId      String?
  userAgent   String?
  ip          String?
  duration    Int      // em ms
  success     Boolean
  errorMessage String?
  createdAt   DateTime @default(now())
}

enum UserRole {
  ADMIN
  COMMON
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum GroupStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum SubscriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlanType {
  SPONSORED_3_DAYS
  SPONSORED_7_DAYS
  PREMIUM_15_DAYS
  PREMIUM_30_DAYS
}
