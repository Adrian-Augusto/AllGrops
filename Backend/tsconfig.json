{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2021",

    "rootDir": "./src",
    "outDir": "./dist",

    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "strict": true,
    "skipLibCheck": true,

    "sourceMap": false
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
