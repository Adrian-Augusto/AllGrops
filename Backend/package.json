{
  "name": "backend",
  "version": "1.0.0",
  "description": "Plataforma de Comunidades Online com NestJS, Prisma e PostgreSQL",
  "main": "dist/main.js",
  "scripts": {
    "install:ci": "npm ci",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "migrate:deploy": "node scripts/safe-migrate.js",
    "db:push": "node node_modules/prisma/build/index.js db push --accept-data-loss",
    "build": "npm install && npm run prisma:generate && node node_modules/typescript/bin/tsc -p tsconfig.json",
    "build:prod": "npm install && npm run prisma:generate && npm run db:push && node node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "npm run build && npm run migrate:deploy && node dist/main.js",
    "start:prod": "npm run build && npm run migrate:deploy && node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/client": "^5.0.0",
    "@types/passport-jwt": "^4.0.1",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^7.1.5",
    "file-type": "^22.0.1",
    "form-data": "^4.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "stripe": "^17.6.0",
    "nodemailer": "^8.0.10",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "8.21.0",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.5.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "8.20.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
